{
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "services": {
      "type": "object",
      "patternProperties": {
        "^s[0-9]+$": {
          "type": "object",
          "required": ["name", "version", "status"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "status": {
              "type": "string",
              "enum": ["active", "deprecated"]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
